---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib';

interface Props {
  talks: CollectionEntry<'talks'>[];
}

const { talks } = Astro.props;
---

<ul class="talks">
  {
    talks.map(({ data }) => (
      <li>
        <span class="kind">{data.kind}</span>
        <span class="title">
          {data.url ? <a href={data.url}>{data.title}</a> : data.title}
          {data.draft && <span class="draft">draft</span>}
        </span>
        <span class="meta">
          {data.event}
          {data.with && ` · with ${data.with}`}
          {data.date ? ` · ${formatDate(data.date, 'year')}` : ' · date TBD'}
          {
            data.links.map((link) => (
              <>
                {' · '}
                <a href={link.url}>{link.label}</a>
              </>
            ))
          }
        </span>
      </li>
    ))
  }
</ul>

<style>
  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    column-gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .meta a {
    color: inherit;
  }

  .draft {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--muted);
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  .kind {
    grid-row: span 2;
    font-size: 0.8rem;
    text-transform: capitalize;
    color: var(--muted);
    padding-top: 0.2rem;
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib';

interface Props {
  talks: CollectionEntry<'talks'>[];
}

const { talks } = Astro.props;
---

<ul class="talks">
  {
    talks.map(({ data }) => (
      <li>
        <span class="title">
          {data.url ? <a href={data.url}>{data.title}</a> : data.title}
          {data.draft && <span class="draft">draft</span>}
        </span>
        <span class="meta">
          <span class="kind">{data.kind}</span>
          {' · '}
          {data.event}
          {data.with && ` · with ${data.with}`}
          {data.date ? ` · ${formatDate(data.date, 'year')}` : ' · date TBD'}
          {
            data.links.map((link) => (
              <>
                {' · '}
                <a href={link.url}>{link.label}</a>
              </>
            ))
          }
        </span>
      </li>
    ))
  }
</ul>

<style>
  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .title a {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
  }

  .title a:hover {
    color: var(--accent);
  }

  .meta a {
    color: inherit;
  }

  .kind {
    text-transform: capitalize;
  }
</style>

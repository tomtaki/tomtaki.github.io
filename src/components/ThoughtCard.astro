---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib';

interface Props {
  post: CollectionEntry<'thoughts'>;
}

const { post } = Astro.props;
const { title, date, kind, summary, image, imageAlt, draft } = post.data;
const href = `/thoughts/${post.id}/`;
---

<article class:list={['card', kind]}>
  <a href={href} class="card-link">
    {kind === 'note' && image && <Image src={image} alt={imageAlt ?? ''} width={640} class="note-image" />}
    <h3>
      {title}
      {draft && <span class="draft">draft</span>}
    </h3>
    {kind !== 'note' && summary && <p>{summary}</p>}
    <p class="meta">
      {formatDate(date)}
      {kind === 'live' && ' · interactive'}
    </p>
  </a>
</article>

<style>
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .card-link:hover h3 {
    color: var(--accent);
  }

  h3 {
    font-family: var(--font-serif);
    margin: 0 0 0.3rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  p {
    margin: 0.25rem 0;
  }

  .note-image {
    border-radius: 0.25rem;
    margin-bottom: 1rem;
  }
</style>

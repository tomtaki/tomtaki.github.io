---
import Base from '../layouts/Base.astro';
import TalkList from '../components/TalkList.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import { getTalks, getThoughts } from '../lib';

// Talks live on the homepage until the list outgrows it, then link to /talks.
const HOME_TALK_LIMIT = 5;
const HOME_THOUGHT_LIMIT = 3;

const talks = await getTalks();
const thoughts = await getThoughts();
---

<Base>
  <section class="hero">
    <div class="intro wrap">
      <p>
        Hello, I’m Tom<br />
        A Principal Experience Designer
      </p>
      <p>
        Currently at <a href="https://www.justworks.com">Justworks</a>.
        Previously at <a href="https://www.etsy.com">Etsy</a>, Gilt, Ralph Lauren &amp; Publicis.
        Loves <a href="https://instagram.com/tomtaki">photography</a>.
      </p>
    </div>
  </section>

  {
    thoughts.length > 0 && (
      <section class="wrap block first-block" aria-labelledby="thoughts-heading">
        <h2 id="thoughts-heading" class="section-title">Thoughts</h2>
        {thoughts.slice(0, HOME_THOUGHT_LIMIT).map((post) => <ThoughtCard post={post} compact />)}
        {thoughts.length > HOME_THOUGHT_LIMIT && <a href="/thoughts/">All thoughts →</a>}
      </section>
    )
  }

  {
    talks.length > 0 && (
      <section class="wrap block" aria-labelledby="talks-heading">
        <h2 id="talks-heading" class="section-title">Talks &amp; podcasts</h2>
        <TalkList talks={talks.slice(0, HOME_TALK_LIMIT)} />
        {talks.length > HOME_TALK_LIMIT && (
          <p>
            <a href="/talks/">All {talks.length} talks &amp; podcasts →</a>
          </p>
        )}
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    /* Pull up behind the (transparent) header so the photo runs to the very
       top of the page — no solid-color band above it. */
    margin-top: -4.75rem;
    height: 82vh;
    min-height: 28rem;
    /* Anchored low (not all the way to the bottom) so `cover` still crops
       mostly from the top, but leaves enough empty space above the
       keepsakes for the text to sit in without crossing them. */
    background: url('/img/bkgd-flatlay.jpg') no-repeat center 15% / cover;
    display: flex;
    align-items: flex-start;
  }

  @media (prefers-color-scheme: dark) {
    .hero {
      background-image: url('/img/bkgd-flatlay-dark.jpg');
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 22%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .intro {
    position: relative;
    z-index: 1;
    padding-top: clamp(6.5rem, 5.5rem + 4vw, 8rem);
    padding-bottom: 2.5rem;
  }

  .intro p:first-of-type {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
    line-height: 1.05;
    margin: 0 0 1.25rem;
  }

  .intro p:not(:first-of-type) {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 0.5em;
  }

  .block {
    margin-top: 3.5rem;
  }

  .first-block {
    position: relative;
    z-index: 1;
    margin-top: -4rem;
  }

  .first-block .section-title {
    margin-bottom: 0.75rem;
  }
</style>
